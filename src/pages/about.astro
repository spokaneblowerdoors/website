---
import Base from '../layouts/Base.astro';
import { business, services } from '../data/business';
---
<Base
  title="About | Spokane Blower Doors"
  description="Spokane Blower Doors is run by Gabe Bell, providing energy code testing across Eastern Washington and North Idaho."
>
  <section class="section">
    <div class="wrap prose">
      <h1>About Spokane Blower Doors</h1>
      <p class="lead">Spokane Blower Doors is run by {business.owner}.</p>
      <p>We work with {business.customersPhrase}. Our services:</p>
      <ul>
        {services.map((s) => <li><a href={`/services/${s.slug}/`}>{s.name}</a></li>)}
      </ul>
      <p>We work across {business.serviceArea}, including {business.towns.slice(0, -1).join(', ')} and {business.towns.at(-1)}.</p>
      <p>Testing is {business.hours.toLowerCase()}. To schedule or get a quote, call <a href={business.phoneHref}>{business.phone}</a> or <a href="/contact/">send a message</a>.</p>
    </div>
  </section>
</Base>
