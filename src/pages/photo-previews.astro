---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { services } from '../data/business';
import pink from '../assets/pink-insulation-wall.jpg';
import brown from '../assets/framing-insulation-panels.jpg';

const service = services.find((s) => s.slug === 'energy-efficiency-consultation')!;
const photoAlt = {
  pink: 'Wall framing with pink insulation installed between the studs',
  brown: 'Framed wall with brown insulation and electrical panels',
};
const options = [
  { n: 1, name: 'Two photos side by side under the introduction' },
  { n: 2, name: 'Two photos stacked at the right of the text' },
  { n: 3, name: 'One photo beside the introduction, one beside “What’s included”' },
  { n: 4, name: 'Two photos in a row beside the closing paragraph, thin border' },
  { n: 5, name: 'Compact overlapping pair with a soft shadow' },
];
---
<Base
  title="Photo layout previews | Spokane Blower Doors"
  description="Temporary preview of five photo layouts for the Energy Efficiency Consultation page."
  noindex
>
  <section class="section">
    <div class="wrap prose">
      <h1>Photo layout previews</h1>
      <p>Five ways to place the two photos on the Energy Efficiency Consultation page. This page is temporary and is not listed in search engines. Pick a number and it will be applied to the real page.</p>
    </div>
  </section>

  {options.map((o) => (
    <section class={`section ${o.n % 2 === 0 ? 'section-soft' : ''}`}>
      <div class="wrap prose">
        <p class="option-label">Option {o.n}: {o.name}</p>
        <h2 class="option-title">{service.name}</h2>

        {o.n === 1 && (
          <>
            <p class="lead">{service.short}</p>
            <div class="pv pv-row">
              <Image src={pink} alt={photoAlt.pink} width={320} densities={[1, 2]} />
              <Image src={brown} alt={photoAlt.brown} width={240} densities={[1, 2]} />
            </div>
            {service.body.map((p) => <p>{p}</p>)}
            <h3>{service.expectHeading}</h3>
            <ul>{service.expect?.map((e) => <li>{e}</li>)}</ul>
            {service.closing?.map((p) => <p>{p}</p>)}
          </>
        )}

        {o.n === 2 && (
          <div class="pv-clear">
            <div class="pv pv-col">
              <Image src={pink} alt={photoAlt.pink} width={220} densities={[1, 2]} />
              <Image src={brown} alt={photoAlt.brown} width={220} densities={[1, 2]} />
            </div>
            <p class="lead">{service.short}</p>
            {service.body.map((p) => <p>{p}</p>)}
            <h3>{service.expectHeading}</h3>
            <ul>{service.expect?.map((e) => <li>{e}</li>)}</ul>
            {service.closing?.map((p) => <p>{p}</p>)}
          </div>
        )}

        {o.n === 3 && (
          <div class="pv-clear">
            <Image class="pv pv-float" src={pink} alt={photoAlt.pink} width={260} densities={[1, 2]} />
            <p class="lead">{service.short}</p>
            {service.body.map((p) => <p>{p}</p>)}
            <Image class="pv pv-float pv-float-left" src={brown} alt={photoAlt.brown} width={190} densities={[1, 2]} />
            <h3>{service.expectHeading}</h3>
            <ul>{service.expect?.map((e) => <li>{e}</li>)}</ul>
            {service.closing?.map((p) => <p>{p}</p>)}
          </div>
        )}

        {o.n === 4 && (
          <>
            <p class="lead">{service.short}</p>
            {service.body.map((p) => <p>{p}</p>)}
            <h3>{service.expectHeading}</h3>
            <ul>{service.expect?.map((e) => <li>{e}</li>)}</ul>
            <div class="pv-split">
              <div class="pv pv-row pv-bordered">
                <Image src={pink} alt={photoAlt.pink} width={220} densities={[1, 2]} />
                <Image src={brown} alt={photoAlt.brown} width={165} densities={[1, 2]} />
              </div>
              <div>{service.closing?.map((p) => <p>{p}</p>)}</div>
            </div>
          </>
        )}

        {o.n === 5 && (
          <>
            <p class="lead">{service.short}</p>
            {service.body.map((p) => <p>{p}</p>)}
            <div class="pv-stack">
              <Image src={pink} alt={photoAlt.pink} width={260} densities={[1, 2]} />
              <Image src={brown} alt={photoAlt.brown} width={170} densities={[1, 2]} />
            </div>
            <h3>{service.expectHeading}</h3>
            <ul>{service.expect?.map((e) => <li>{e}</li>)}</ul>
            {service.closing?.map((p) => <p>{p}</p>)}
          </>
        )}
      </div>
    </section>
  ))}
</Base>

<style is:global>
  .option-label { font-weight: 700; color: var(--brand); margin: 0 0 .25rem; }
  .option-title { margin-top: 0; }
  .pv, .pv-stack img, .pv-float { border-radius: 12px; }
  .pv img, img.pv { border-radius: 12px; display: block; max-width: 100%; height: auto; }
  .pv-row { display: flex; flex-wrap: wrap; gap: 12px; align-items: flex-start; margin: 1rem 0; }
  .pv-row img { max-width: 100%; height: auto; border-radius: 12px; }
  .pv-clear::after { content: ''; display: block; clear: both; }
  .pv-col { float: right; width: 220px; margin: 0 0 12px 20px; display: flex; flex-direction: column; gap: 12px; }
  .pv-col img { width: 100%; height: auto; border-radius: 12px; }
  img.pv-float { float: right; margin: 4px 0 12px 20px; height: auto; max-width: 45%; }
  img.pv-float-left { float: left; margin: 4px 20px 12px 0; }
  .pv-split { display: flex; flex-wrap: wrap; gap: 20px; align-items: center; margin-top: 1rem; }
  .pv-split > div:last-child { flex: 1 1 14rem; }
  .pv-bordered { margin: 0; }
  .pv-bordered img { border: 1px solid var(--line); padding: 3px; background: #fff; border-radius: 12px; }
  .pv-stack { position: relative; width: 100%; max-width: 380px; height: 260px; margin: 1.25rem 0; }
  .pv-stack img { position: absolute; height: auto; box-shadow: 0 6px 18px rgba(19, 32, 46, .18); border: 3px solid #fff; }
  .pv-stack img:first-child { left: 0; top: 0; }
  .pv-stack img:last-child { left: 190px; top: 36px; max-width: calc(100% - 190px); }
  @media (max-width: 520px) {
    .pv-col, img.pv-float, img.pv-float-left { float: none; width: auto; margin: 12px 0; max-width: 100%; }
    .pv-col { flex-direction: row; }
    .pv-col img { width: 50%; }
  }
</style>
