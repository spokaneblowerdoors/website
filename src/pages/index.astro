---
import Base from '../layouts/Base.astro';
import { business, services } from '../data/business';
---
<Base
  title="Blower Door Test Spokane | Spokane Blower Doors"
  description="Blower door tests, duct leakage tests, Washington energy code compliance and Energy Star testing in Spokane and North Idaho. Call 509-903-8595."
>
  <section class="hero">
    <div class="wrap">
      <h1>Blower door and duct leakage testing in Spokane and North Idaho</h1>
      <p>Energy code testing for {business.customersPhrase} across {business.serviceArea}.</p>
      <div class="actions">
        <a class="btn btn-call" href={business.phoneHref}>Call {business.phone}</a>
        <a class="btn btn-secondary" href="/contact/">Send a message</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Services</h2>
      <p class="lead">Testing and calculations for new homes, remodels and existing homes. {business.pricing}.</p>
      <div class="cards">
        {services.map((s) => (
          <article class="card">
            <h3>{s.name}</h3>
            <p>{s.short}</p>
            <a class="more" href={`/services/${s.slug}/`}>Learn more<span class="visually-hidden"> about {s.name}</span><span aria-hidden="true"> →</span></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="wrap">
      <h2>Who we work with</h2>
      <ul class="pills">
        {business.customers.map((c) => <li>{c}</li>)}
      </ul>
      <h2 style="margin-top:40px">Where we work</h2>
      <p class="lead">{business.serviceArea}, including:</p>
      <ul class="pills">
        {business.towns.map((t) => <li>{t}</li>)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="cta">
        <div>
          <h2>Need a test scheduled?</h2>
          <p>Testing is {business.hours.toLowerCase()}. {business.pricing}.</p>
        </div>
        <a class="btn btn-call" href={business.phoneHref}>Call {business.phone}</a>
      </div>
    </div>
  </section>
</Base>
