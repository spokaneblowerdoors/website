---
import Base from '../layouts/Base.astro';
import { business, services } from '../data/business';
---
<Base
  title="Spokane Blower Doors | Building Performance Testing"
  description="Building performance testing in Eastern WA and North Idaho: blower door and duct leakage tests, ERI scores, C3 calculations and audits."
>
  <section class="hero">
    <div class="wrap">
      <h1>Building performance testing in Eastern Washington and North Idaho</h1>
      <p>Envelope airtightness and duct leakage testing, ERI scores, Washington energy code calculations and home energy audits for {business.customersPhrase}.</p>
      <div class="actions">
        <a class="btn btn-call" href={business.phoneHref}>Call {business.phone}</a>
        <a class="btn btn-secondary" href="/contact/">Send a message</a>
      </div>
    </div>
    <svg class="deco" viewBox="0 0 600 100" preserveAspectRatio="none" aria-hidden="true">
      <g fill="none" stroke="#fff" stroke-linecap="round" stroke-opacity=".16" stroke-width="2">
        <path d="M0 80 C150 30 300 100 600 40" />
        <path d="M0 62 C160 12 320 82 600 22" />
        <path d="M0 44 C170 -6 340 64 600 4" />
        <path d="M0 98 C140 48 280 118 600 58" />
      </g>
      <path d="M0 70 C155 20 310 90 600 30" fill="none" stroke="#f2b705" stroke-opacity=".55" stroke-width="3" stroke-linecap="round" />
    </svg>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Services</h2>
      <p class="lead">{business.pricing}.</p>
      <div class="cards">
        {services.map((s) => (
          <article class="card">
            <h3>{s.cardName ?? s.name}</h3>
            <p>{s.cardText ?? s.short}</p>
            <a class="more" href={`/services/${s.slug}/`}>Learn more<span class="visually-hidden"> about {s.name}</span><span aria-hidden="true"> →</span></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="wrap">
      <div class="cards" style="margin-top:0">
        <div>
          <h2>Standards and methods</h2>
          <ul class="plain">
            {business.standards.map((s) => <li>{s}</li>)}
          </ul>
          <p style="margin-top:12px">Equipment: calibrated {business.equipment} test equipment.</p>
          <p>{business.credential}</p>
        </div>
        <div>
          <h2>Reported results, as applicable</h2>
          <ul class="plain">
            {business.reporting.map((r) => <li>{r}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="cta">
        <div>
          <h2>Schedule testing</h2>
          <p>Service is {business.hours.toLowerCase()}. {business.pricing}.</p>
        </div>
        <a class="btn btn-call" href={business.phoneHref}>Call {business.phone}</a>
      </div>
    </div>
  </section>
</Base>
