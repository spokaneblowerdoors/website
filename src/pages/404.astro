  <section class="section">
    <div class="wrap prose">
      <h1>Page not found</h1>
      <p>Sorry, that page isn't here. Try the <a href="/">home page</a> or <a href="/services/">our services</a>, or call <a href={business.phoneHref}>{business.phone}</a>.</p>
    </div>
  </section>
</Base>
