---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import pinkWall from '../../assets/pink-insulation-wall.jpg';
import brownWall from '../../assets/framing-insulation-panels.jpg';
import { business, services, type Service } from '../../data/business';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

interface Props { service: Service }
const { service } = Astro.props;
const others = services.filter((s) => s.slug !== service.slug);
---
<Base title={service.title} description={service.description}>
  <section class="section">
    <div class="wrap prose">
      <p class="breadcrumb"><a href="/services/">Services</a> / {service.name}</p>
      <h1>{service.name}</h1>
      <p class="lead">{service.short}</p>
      {service.body.map((p) => <p>{p}</p>)}
      {service.slug === 'energy-efficiency-consultation' && (
        <div class="photo-pair">
          <Image src={pinkWall} alt="Wall framing with pink insulation installed between the studs" width={260} densities={[1, 2]} />
          <Image src={brownWall} alt="Framed wall with brown insulation and electrical panels" width={170} densities={[1, 2]} />
        </div>
      )}
      {service.expect && (
        <>
          <h2>{service.expectHeading ?? 'What builders can expect'}</h2>
          <ul>{service.expect.map((e) => <li>{e}</li>)}</ul>
        </>
      )}
      {service.closing?.map((p) => <p>{p}</p>)}
      {service.reports && (
        <>
          <h2>{service.slug === 'washington-energy-code-compliance' ? 'Deliverable' : service.slug === 'eri-scores' ? 'Result' : 'Reported results'}</h2>
          <ul>{service.reports.map((r) => <li>{r}</li>)}</ul>
        </>
      )}
      <h2>Service area and scheduling</h2>
      <p>Serving {service.slug === 'home-energy-audits' ? 'homeowners' : business.customersPhrase} across {business.serviceArea}.</p>
      <p>Service is {business.hours.toLowerCase()}. {business.pricing}: <a href={business.phoneHref}>{business.phone}</a>.</p>
      <p><a class="btn btn-primary" href="/contact/">Ask about {service.name}</a></p>
    </div>
  </section>
  <section class="section section-soft">
    <div class="wrap">
      <h2>Other services</h2>
      <ul class="plain">
        {others.map((s) => <li><a href={`/services/${s.slug}/`}>{s.name}</a></li>)}
      </ul>
    </div>
  </section>
</Base>

<style is:global>
  .photo-pair { position: relative; width: 100%; max-width: 380px; height: 260px; margin: 1.25rem 0; }
  .photo-pair img { position: absolute; height: auto; border-radius: 12px; border: 3px solid #fff; box-shadow: 0 6px 18px rgba(19, 32, 46, .18); }
  .photo-pair img:first-child { left: 0; top: 0; }
  .photo-pair img:last-child { left: 190px; top: 36px; max-width: calc(100% - 190px); }
</style>
