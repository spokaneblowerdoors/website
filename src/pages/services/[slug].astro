---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { business, services, type Service } from '../../data/business';
import blowerDoor from '../../assets/blower-door-setup.jpg';
import pinkInsulation from '../../assets/pink-insulation-wall.jpg';
import framingPanels from '../../assets/framing-insulation-panels.jpg';
import ductFan from '../../assets/duct-test-fan.jpg';
import ductAirHandler from '../../assets/duct-test-air-handler.jpg';
import eriGauge from '../../assets/eri-score-gauge.png';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

interface Props { service: Service }
const { service } = Astro.props;
const others = services.filter((s) => s.slug !== service.slug);
---
<Base title={service.title} description={service.description}>
  <section class="section">
    <div class="wrap prose">
      <p class="breadcrumb"><a href="/services/">Services</a> / {service.name}</p>
      <h1>{service.name}</h1>
      <p class="lead">{service.short}</p>
      {service.slug === 'blower-door-testing' && (
        <Image
          class="service-photo"
          src={blowerDoor}
          alt="Retrotec blower door fan and frame set up in a doorway"
          width={240}
          densities={[1, 2]}
        />
      )}
      {service.slug === 'duct-leakage-testing' && (
        <div class="photo-stack">
          <Image src={ductAirHandler} alt="Flexible duct connected to a sealed air handler opening" width={200} densities={[1, 2]} />
          <Image src={ductFan} alt="Test fan connected to flexible duct on a slab floor" width={200} densities={[1, 2]} />
        </div>
      )}
      {service.slug === 'eri-scores' && (
        <Image
          class="eri-gauge"
          src={eriGauge}
          alt="Energy Rating Index gauge showing an ERI of 47, ERI with PV of 47, ERI Target of 77, and UA Compliance: Pass"
          width={300}
          densities={[1, 2]}
        />
      )}
      {service.body.map((p) => <p>{p}</p>)}
      {service.slug === 'energy-efficiency-consultation' && (
        <div class="photo-pair">
          <Image src={pinkInsulation} alt="Wall framing with pink insulation installed between the studs" width={260} densities={[1, 2]} />
          <Image src={framingPanels} alt="Framed wall with brown insulation and electrical panels" width={170} densities={[1, 2]} />
        </div>
      )}
      {service.expect && (
        <>
          <h2>{service.expectHeading ?? 'What builders can expect'}</h2>
          <ul>{service.expect.map((e) => <li>{e}</li>)}</ul>
        </>
      )}
      {service.closing?.map((p) => <p>{p}</p>)}
      {service.reports && (
        <>
          <h2>{service.slug === 'washington-energy-code-compliance' ? 'Deliverable' : service.slug === 'eri-scores' ? 'Result' : 'Reported results'}</h2>
          <ul>{service.reports.map((r) => <li>{r}</li>)}</ul>
        </>
      )}
      <h2>Service area and scheduling</h2>
      <p>Serving {service.slug === 'home-energy-audits' ? 'homeowners' : business.customersPhrase} across {business.serviceArea}.</p>
      <p>Service is {business.hours.toLowerCase()}. {business.pricing}: <a href={business.phoneHref}>{business.phone}</a>.</p>
      <p><a class="btn btn-primary" href="/contact/">Ask about {service.name}</a></p>
    </div>
  </section>
  <section class="section section-soft">
    <div class="wrap">
      <h2>Other services</h2>
      <ul class="plain">
        {others.map((s) => <li><a href={`/services/${s.slug}/`}>{s.name}</a></li>)}
      </ul>
    </div>
  </section>
</Base>

<style is:global>
  .eri-gauge { float: right; width: 300px; max-width: 45%; height: auto; margin: 4px 0 16px 24px; border-radius: 12px; background: #fff; box-shadow: 0 6px 20px rgba(19, 32, 46, .22), 0 1px 4px rgba(19, 32, 46, .12); }
  @media (max-width: 600px) { .eri-gauge { float: none; display: block; max-width: 100%; margin: 16px auto; } }
  .photo-stack { float: right; display: flex; flex-direction: column; gap: 12px; width: 200px; max-width: 40%; margin: 4px 0 12px 20px; }
  .photo-stack img { width: 100%; height: auto; border-radius: 12px; }
  @media (max-width: 600px) { .photo-stack { float: none; max-width: 70%; margin: 12px auto; } }
  .photo-pair { position: relative; width: 100%; max-width: 380px; height: 260px; margin: 1.25rem 0; }
  .photo-pair img { position: absolute; height: auto; border-radius: 12px; border: 3px solid #fff; box-shadow: 0 6px 18px rgba(19, 32, 46, .18); }
  .photo-pair img:first-child { left: 0; top: 0; }
  .photo-pair img:last-child { left: 190px; top: 36px; max-width: calc(100% - 190px); }
</style>
